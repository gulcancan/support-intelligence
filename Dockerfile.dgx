# ═══════════════════════════════════════════════════════════
# Dockerfile for NVIDIA DGX Spark (Grace Blackwell, 128GB unified memory)
#
# Uses NVIDIA PyTorch base image with CUDA pre-installed.
# Trains DistilBERT on GPU with large batch sizes.
# ═══════════════════════════════════════════════════════════

FROM nvcr.io/nvidia/pytorch:24.05-py3

# The NVIDIA image already includes:
#   - Python 3.10, PyTorch 2.4+ with CUDA, cuDNN, NCCL
#   - ~15GB image, but everything GPU-related is pre-built and optimized

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install remaining Python deps (torch is already in the base image)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
COPY scripts/ scripts/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Allow PyTorch to see the GPU
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
