# ═══════════════════════════════════════════════════════════
# Dockerfile for NVIDIA DGX Spark (Grace Blackwell GB10)
#
# Base: nvcr.io/nvidia/pytorch:25.11-py3
#   - Python 3.12, PyTorch 2.10.0a0, CUDA 13.0
#   - Native Blackwell (sm_121 / GB10 / B200) support
#   - This is the NVIDIA-recommended container for DGX Spark
#     https://build.nvidia.com/spark/unsloth/instructions
#
# Note: Starting from 25.03, NVIDIA containers include
#   /etc/pip/constraint.txt that pins package versions.
#   We remove constraints for packages we need to install fresh.
# ═══════════════════════════════════════════════════════════
FROM nvcr.io/nvidia/pytorch:25.11-py3

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Remove pip constraints for packages we need to install/upgrade.
# The NVIDIA constraint file prevents pip from installing newer versions.
COPY requirements.dgx.txt .
RUN if [ -f /etc/pip/constraint.txt ]; then \
        sed -i '/transformers/d; /sentence.transformers/d; /scikit.learn/d; /fastapi/d; /uvicorn/d; /pydantic/d; /sqlalchemy/d; /mlflow/d; /optuna/d; /pandas/d; /numpy/d' \
        /etc/pip/constraint.txt; \
    fi && \
    pip install --no-cache-dir -r requirements.dgx.txt

# Copy application code
COPY src/ src/
COPY scripts/ scripts/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
